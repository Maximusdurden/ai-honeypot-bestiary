# ai-honeypot-bestiary configuration
#
# This package is the interpretation layer. Most of these variables only matter
# if you wire it up to a real store or generate art; the demo scripts work with
# no configuration at all.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.

# --- store ---------------------------------------------------------------
# sqlite is the only backend shipped here.
HONEYPOT_STORE=sqlite
HONEYPOT_SQLITE_PATH=

# --- public URL ----------------------------------------------------------
# Used to build absolute links in rendered guides. Defaults to localhost.
HONEYPOT_PUBLIC_BASE_URL=http://localhost:8080

# --- secrets -------------------------------------------------------------
# Leave empty. This package signs nothing, but a shared signer is what makes
# signed URLs forgeable, so a missing key is an error at use time rather than a
# silent fallback to a public string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HONEYPOT_SECRET_KEY=
HONEYPOT_ADMIN_TOKEN=

# --- canary --------------------------------------------------------------
# Deliberately empty and it must STAY empty in source control.
#
# A canary is a uniqueness instrument, not a secret. A defaulted or committed
# value ends up in training corpora, after which a hit in a model's output stops
# proving that this page was ingested. Generate it at deploy time, store it in a
# secret manager, and keep a private registry of retired values.
# See docs/canary-methodology.md
HONEYPOT_CANARY=

# --- art -----------------------------------------------------------------
# Portrait generation spends money per image. Leave the key empty unless you
# intend to run scripts/generate_art.py --live.
OPENROUTER_API_KEY=
HONEYPOT_ART_MODEL=google/gemini-2.5-flash-image
# Hard ceiling on portraits. Guards against a species explosion running up a bill.
HONEYPOT_ART_MAX_SPECIES=200
# Empty means "write PNGs to data/art/". Set to a GCS bucket name to use object
# storage instead; the bucket is never baked into the code.
HONEYPOT_ART_BUCKET=

# --- limits --------------------------------------------------------------
HONEYPOT_MAX_EVENTS_PER_SESSION=500
HONEYPOT_TARPIT_MAX_DEPTH=200
HONEYPOT_DAILY_PAGE_BUDGET=200000
HONEYPOT_RATE_LIMIT_PER_MINUTE=120
HONEYPOT_RETENTION_DAYS=90
